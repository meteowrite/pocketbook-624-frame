From c87b8bda949babf422da3ce332ad8b9f0529d97a Mon Sep 17 00:00:00 2001
From: meteowrite <dtodorovtu@gmail.com>
Date: Sun, 11 Oct 2026 21:37:00 +0300
Subject: [PATCH 3/3] dt-bindings: input: touchscreen: msg2638: Allow common
 touchscreen properties

The binding references touchscreen.yaml but uses additionalProperties,
so only touchscreen-size-x/y are accepted. Boards that mount the panel
rotated or mirrored need touchscreen-inverted-x/y and
touchscreen-swapped-x-y, which the driver already handles through
touchscreen_parse_properties().

Switch to unevaluatedProperties so all common touchscreen properties
are allowed.

Signed-off-by: meteowrite <dtodorovtu@gmail.com>
---
 .../devicetree/bindings/input/touchscreen/mstar,msg2638.yaml    | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/Documentation/devicetree/bindings/input/touchscreen/mstar,msg2638.yaml b/Documentation/devicetree/bindings/input/touchscreen/mstar,msg2638.yaml
index ddbbc820c7e5..9ee7c27473d7 100644
--- a/Documentation/devicetree/bindings/input/touchscreen/mstar,msg2638.yaml
+++ b/Documentation/devicetree/bindings/input/touchscreen/mstar,msg2638.yaml
@@ -40,7 +40,7 @@ properties:
     minItems: 1
     maxItems: 4
 
-additionalProperties: false
+unevaluatedProperties: false
 
 required:
   - compatible
-- 
2.39.5

