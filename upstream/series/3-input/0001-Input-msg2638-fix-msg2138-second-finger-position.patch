From dd176be4df25e4343509973c69eaa78f5cf4a5a4 Mon Sep 17 00:00:00 2001
From: meteowrite <dtodorovtu@gmail.com>
Date: Sun, 11 Oct 2026 21:36:20 +0300
Subject: [PATCH 1/3] Input: msg2638 - fix msg2138 second finger position

The msg2138 reports the second finger as a 12-bit two's complement
offset from the first one, so a second finger left of or above the
first one has a negative delta. The driver adds the raw 12-bit value
instead, putting such a finger up to 4095 units off.

Sign-extend the deltas, as the vendor msg21xx driver does
("if (dst_x > 2048) dst_x -= 4096").

Fixes: ae6b18e631d6 ("Input: msg2638 - add support for msg2138")
Signed-off-by: meteowrite <dtodorovtu@gmail.com>
---
 drivers/input/touchscreen/msg2638.c | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/drivers/input/touchscreen/msg2638.c b/drivers/input/touchscreen/msg2638.c
index cd40c284d6f4..1c9ee9e16875 100644
--- a/drivers/input/touchscreen/msg2638.c
+++ b/drivers/input/touchscreen/msg2638.c
@@ -118,7 +118,8 @@ static irqreturn_t msg2138_ts_irq_handler(int irq, void *msg2638_handler)
 		},
 	};
 	struct msg2138_packet *p0, *p1;
-	u16 x, y, delta_x, delta_y;
+	u16 x, y;
+	s16 delta_x, delta_y;
 	int ret;
 
 	ret = i2c_transfer(client->adapter, msg, ARRAY_SIZE(msg));
@@ -156,9 +157,9 @@ static irqreturn_t msg2138_ts_irq_handler(int irq, void *msg2638_handler)
 	if (p1->xy_hi == 0xFF && p1->x_low == 0xFF && p1->y_low == 0xFF)
 		goto report;
 
-	/* Second finger is reported as a delta position */
-	delta_x = ((p1->xy_hi & 0xF0) << 4) | p1->x_low;
-	delta_y = ((p1->xy_hi & 0x0F) << 8) | p1->y_low;
+	/* Second finger is reported as a signed 12-bit delta position */
+	delta_x = sign_extend32(((p1->xy_hi & 0xF0) << 4) | p1->x_low, 11);
+	delta_y = sign_extend32(((p1->xy_hi & 0x0F) << 8) | p1->y_low, 11);
 
 	/* Ignore second finger if both deltas equal 0 */
 	if (delta_x == 0 && delta_y == 0)
