// SPDX-License-Identifier: GPL-2.0
/*
 * PocketBook 624 (Basic Touch, pb624-D-ww) - full board.
 *
 * Based on the stock script0.fex and the mainline PocketBook Touch Lux 3 DT
 * (same A13 platform).  The ED060SCE e-ink panel is driven by TCON0 as a
 * 258x620 "step buffer" (see sun5i-a13-pocketbook-624-epd.dts / README);
 * userspace (epdshow) owns the panel rails, so they are not claimed here.
 *
 *   i2c0  AXP209 PMIC @0x34
 *   i2c1  PCF8563 RTC @0x51 (+ crypto chip @0x3d, unused)
 *   i2c2  MStar msg2133 touch controller @0x26 (stock "cnt_ts")
 *   USB1  RTL8188EUS Wi-Fi, powered by AXP LDO3
 *   mmc0  external microSD, power PE4 (active low), CD PG0
 *   mmc2  internal microSD (PC6-11)
 */

/dts-v1/;
#include "sun5i-a13.dtsi"
#include "sunxi-common-regulators.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/interrupt-controller/irq.h>

/ {
	model = "PocketBook 624";
	compatible = "pocketbook,624", "allwinner,sun5i-a13";

	aliases {
		serial0 = &uart1;
		mmc0 = &mmc0;
		mmc1 = &mmc2;
		i2c0 = &i2c0;
		i2c1 = &i2c1;
		i2c2 = &i2c2;
		rtc0 = &pcf8563;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	leds {
		compatible = "gpio-leds";

		led-0 {
			label = "pb624:green:status";
			gpios = <&pio 4 8 GPIO_ACTIVE_LOW>; /* PE8 */
			default-state = "off";
		};
	};

	gpio-keys {
		compatible = "gpio-keys";
		label = "GPIO Keys";

		/* 2nd front button from the left (stock: KEY_HOME) */
		key-home {
			label = "Home";
			linux,code = <KEY_HOME>;
			gpios = <&pio 6 10 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; /* PG10 */
			wakeup-source;
		};

		/* 3rd front button from the left (stock: KEY_BACK) */
		key-back {
			label = "Back";
			linux,code = <KEY_BACK>;
			gpios = <&pio 6 9 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; /* PG9 */
			wakeup-source;
		};
	};

	reg_3v3_mmc0: regulator-mmc0 {
		compatible = "regulator-fixed";
		regulator-name = "vdd-mmc0";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&pio 4 4 GPIO_ACTIVE_LOW>; /* PE4 */
		vin-supply = <&reg_vcc3v3>;
		/*
		 * U-Boot leaves the card powered and initialised; the regulator
		 * probe switches it off and the MMC core straight back on.  Give
		 * the card a real power cycle or it comes back confused.
		 */
		off-on-delay-us = <200000>;
	};

	/* touch controller supply, PE5 low = on (stock fex ctp_powerpin) */
	reg_touch: regulator-touch {
		compatible = "regulator-fixed";
		regulator-name = "vdd-touch";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&pio 4 5 GPIO_ACTIVE_LOW>; /* PE5 */
		vin-supply = <&reg_vcc3v3>;
	};

	epd_panel: panel {
		compatible = "panel-dpi";
		width-mm = <122>;
		height-mm = <91>;

		panel-timing {
			clock-frequency = <16000000>;
			hactive = <258>;
			vactive = <620>;
			hfront-porch = <11>;
			hsync-len = <1>;
			hback-porch = <1>;
			vfront-porch = <73>;
			vsync-len = <1>;
			vback-porch = <1>;
			hsync-active = <0>;
			vsync-active = <0>;
			de-active = <1>;
			pixelclk-active = <0>;
		};

		port {
			panel_in: endpoint {
				remote-endpoint = <&tcon0_out_panel>;
			};
		};
	};
};

&be0 {
	status = "okay";
};

&cpu0 {
	cpu-supply = <&reg_dcdc2>;
};

&ehci0 {
	status = "okay";
};

&ohci0 {
	status = "okay";
};

&i2c0 {
	status = "okay";

	axp209: pmic@34 {
		reg = <0x34>;
		interrupts = <0>;
	};
};

#include "axp209.dtsi"

&i2c1 {
	status = "okay";

	/*
	 * INT is wired to the NMI pin together with the AXP209 IRQ (an
	 * unhandled alarm storms IRQ 0).  It cannot power the AXP on, but
	 * wakes the SoC from suspend.
	 */
	pcf8563: rtc@51 {
		compatible = "nxp,pcf8563";
		reg = <0x51>;
		interrupts = <0>;
		#clock-cells = <0>;
		wakeup-source;
	};
};

&i2c2 {
	status = "okay";

	/*
	 * msg2133, msg21xx protocol (8-byte packets, magic 0x52).  Raw
	 * coordinates are 0..2047 on both axes; on the 800x600 panel
	 * x = raw y and y = 2047 - raw x (stock cnt_ts_pb.ko).
	 */
	touchscreen@26 {
		compatible = "mstar,msg2138";
		reg = <0x26>;
		interrupt-parent = <&pio>;
		interrupts = <6 11 IRQ_TYPE_EDGE_FALLING>; /* PG11 / EINT11 */
		reset-gpios = <&pio 1 3 GPIO_ACTIVE_LOW>; /* PB3 */
		vdd-supply = <&reg_touch>;
		vddio-supply = <&reg_vcc3v3>;
		touchscreen-size-x = <2048>;
		touchscreen-size-y = <2048>;
		touchscreen-inverted-x;
		touchscreen-swapped-x-y;
	};
};

&lradc {
	vref-supply = <&reg_ldo2>;
	wakeup-source;
	status = "okay";

	/*
	 * Measured raw LRADC codes 9 and 42 (of 63, vref = 2/3 * avcc = 2.0 V).
	 * Front buttons left to right: LRADC 0.29 V, PG10, PG9, LRADC 1.33 V.
	 */
	button-285 {
		label = "Left";
		linux,code = <KEY_LEFT>;
		channel = <0>;
		voltage = <285714>;
	};

	button-1333 {
		label = "Right";
		linux,code = <KEY_RIGHT>;
		channel = <0>;
		voltage = <1333333>;
	};
};

&mmc0 {
	pinctrl-names = "default";
	pinctrl-0 = <&mmc0_pins>;
	vmmc-supply = <&reg_3v3_mmc0>;
	bus-width = <4>;
	cd-gpios = <&pio 6 0 GPIO_ACTIVE_LOW>; /* PG0 */
	status = "okay";
};

&mmc2 {
	pinctrl-names = "default";
	pinctrl-0 = <&mmc2_4bit_pc_pins>;
	vmmc-supply = <&reg_vcc3v3>;
	bus-width = <4>;
	broken-cd;
	status = "okay";
};

&pio {
	lcd_epd_pins: lcd-epd-pins {
		pins = "PD3", "PD4", "PD5", "PD6", "PD7",
		       "PD10", "PD11", "PD12", "PD13", "PD15",
		       "PD20", "PD21", "PD22", "PD23", "PD24";
		function = "lcd0";
	};
};

&tcon0 {
	pinctrl-names = "default";
	pinctrl-0 = <&lcd_epd_pins>;
	status = "okay";
};

&tcon0_out {
	tcon0_out_panel: endpoint@0 {
		reg = <0>;
		remote-endpoint = <&panel_in>;
	};
};

&reg_dcdc2 {
	regulator-always-on;
	regulator-min-microvolt = <1000000>;
	regulator-max-microvolt = <1400000>;
	regulator-name = "vdd-cpu";
};

&reg_dcdc3 {
	regulator-always-on;
	regulator-min-microvolt = <1200000>;
	regulator-max-microvolt = <1200000>;
	regulator-name = "vdd-int-pll";
};

&reg_ldo1 {
	regulator-name = "vdd-rtc";
};

&reg_ldo2 {
	regulator-always-on;
	regulator-min-microvolt = <3000000>;
	regulator-max-microvolt = <3000000>;
	regulator-name = "avcc";
};

&reg_ldo3 {
	regulator-min-microvolt = <3300000>;
	regulator-max-microvolt = <3300000>;
	regulator-name = "vcc-wifi";
	regulator-soft-start;
	regulator-ramp-delay = <1600>;
};

/* 3.3 V in the stock fex; consumer unknown, so never switch it off */
&reg_ldo4 {
	regulator-always-on;
	regulator-min-microvolt = <3300000>;
	regulator-max-microvolt = <3300000>;
	regulator-name = "vcc-ldo4";
};

&ac_power_supply {
	status = "okay";
};

&battery_power_supply {
	status = "okay";
};

&usb_power_supply {
	status = "okay";
};

&otg_sram {
	status = "okay";
};

/* FEL port: peripheral, so musb drops the BROM's D+ pull-up at boot */
&usb_otg {
	dr_mode = "peripheral";
	status = "okay";
};

&usbphy {
	usb1_vbus-supply = <&reg_ldo3>;
	status = "okay";
};

&uart1 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart1_pg_pins>;
	status = "okay";
};
