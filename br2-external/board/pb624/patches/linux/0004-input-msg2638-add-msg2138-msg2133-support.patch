From: PB624 bring-up
Subject: [PATCH] Input: msg2638 - add msg2138 (msg2133) support

The PocketBook 624 uses an MStar msg2133 (stock driver "cnt_ts"), which
speaks the msg21xx protocol: an 8-byte packet with magic 0x52, the first
finger as absolute 12-bit coordinates and the second as a signed 12-bit
offset from it, then a two's complement checksum.  Add it as
"mstar,msg2138" (the upstream name for this family, as in later kernels).
The msg2133 needs ~1.2 s after reset before it answers on I2C; I2C errors
in that window are not logged.

---
--- a/drivers/input/touchscreen/msg2638.c	2026-10-11 17:37:44.333237607 +0300
+++ b/drivers/input/touchscreen/msg2638.c	2026-10-11 18:06:32.505715901 +0300
@@ -18,15 +18,19 @@
 #include <linux/input/mt.h>
 #include <linux/input/touchscreen.h>
 #include <linux/interrupt.h>
+#include <linux/jiffies.h>
 #include <linux/kernel.h>
 #include <linux/mod_devicetable.h>
 #include <linux/module.h>
+#include <linux/of_device.h>
 #include <linux/regulator/consumer.h>
 #include <linux/slab.h>
 
 #define MODE_DATA_RAW			0x5A
+#define MSG2138_MODE_DATA		0x52
 
 #define MAX_SUPPORTED_FINGER_NUM	5
+#define MSG2138_MAX_FINGERS		2
 
 #define CHIP_ON_DELAY_MS		15
 #define FIRMWARE_ON_DELAY_MS		50
@@ -47,12 +51,38 @@
 	u8	checksum;
 };
 
+/*
+ * msg2133/msg2138: the second finger is sent as a signed 12-bit offset
+ * from the first one; all-0xFF first finger means nothing is touched.
+ */
+struct msg2138_packet {
+	u8	xy_hi;
+	u8	x_low;
+	u8	y_low;
+};
+
+struct msg2138_touch_event {
+	u8	magic;
+	struct	msg2138_packet pkt[MSG2138_MAX_FINGERS];
+	u8	checksum;
+};
+
+struct msg2638_ts_data;
+
+struct msg_chip_data {
+	irq_handler_t irq_handler;
+	unsigned int max_fingers;
+	unsigned int boot_ms;	/* until the firmware answers on I2C */
+};
+
 struct msg2638_ts_data {
+	const struct msg_chip_data *chip_data;
 	struct i2c_client *client;
 	struct input_dev *input_dev;
 	struct touchscreen_properties prop;
 	struct regulator_bulk_data supplies[2];
 	struct gpio_desc *reset_gpiod;
+	unsigned long ready;	/* jiffies when the firmware is up */
 };
 
 static u8 msg2638_checksum(u8 *data, u32 length)
@@ -125,12 +155,77 @@
 	return IRQ_HANDLED;
 }
 
+static irqreturn_t msg2138_ts_irq_handler(int irq, void *msg2638_handler)
+{
+	struct msg2638_ts_data *msg2638 = msg2638_handler;
+	struct i2c_client *client = msg2638->client;
+	struct input_dev *input = msg2638->input_dev;
+	struct msg2138_touch_event touch_event;
+	struct msg2138_packet *p0, *p1;
+	u16 x, y;
+	s16 dx, dy;
+	int ret;
+
+	ret = i2c_master_recv(client, (u8 *)&touch_event, sizeof(touch_event));
+	if (ret != sizeof(touch_event)) {
+		/* the msg2133 NAKs for ~1.2 s after reset while it boots */
+		if (time_after(jiffies, msg2638->ready))
+			dev_err_ratelimited(&client->dev,
+				"Failed I2C transfer in irq handler: %d\n",
+				ret < 0 ? ret : -EIO);
+		goto out;
+	}
+
+	if (touch_event.magic != MSG2138_MODE_DATA)
+		goto out;
+
+	if (msg2638_checksum((u8 *)&touch_event, sizeof(touch_event) - 1) !=
+						touch_event.checksum) {
+		dev_err(&client->dev, "Failed checksum!\n");
+		goto out;
+	}
+
+	p0 = &touch_event.pkt[0];
+	p1 = &touch_event.pkt[1];
+
+	/* Ignore non-pressed finger data */
+	if (p0->xy_hi == 0xFF && p0->x_low == 0xFF && p0->y_low == 0xFF)
+		goto report;
+
+	x = ((p0->xy_hi & 0xF0) << 4) | p0->x_low;
+	y = ((p0->xy_hi & 0x0F) << 8) | p0->y_low;
+
+	input_mt_slot(input, 0);
+	input_mt_report_slot_state(input, MT_TOOL_FINGER, true);
+	touchscreen_report_pos(input, &msg2638->prop, x, y, true);
+
+	/* Ignore non-pressed finger 2 data */
+	if (p1->xy_hi == 0x00 && p1->x_low == 0x00 && p1->y_low == 0x00)
+		goto report;
+
+	/* Second finger is reported as a delta from the first one */
+	dx = sign_extend32(((p1->xy_hi & 0xF0) << 4) | p1->x_low, 11);
+	dy = sign_extend32(((p1->xy_hi & 0x0F) << 8) | p1->y_low, 11);
+
+	input_mt_slot(input, 1);
+	input_mt_report_slot_state(input, MT_TOOL_FINGER, true);
+	touchscreen_report_pos(input, &msg2638->prop, x + dx, y + dy, true);
+
+report:
+	input_mt_sync_frame(msg2638->input_dev);
+	input_sync(msg2638->input_dev);
+
+out:
+	return IRQ_HANDLED;
+}
+
 static void msg2638_reset(struct msg2638_ts_data *msg2638)
 {
 	gpiod_set_value_cansleep(msg2638->reset_gpiod, 1);
 	usleep_range(RESET_DELAY_MIN_US, RESET_DELAY_MAX_US);
 	gpiod_set_value_cansleep(msg2638->reset_gpiod, 0);
 	msleep(FIRMWARE_ON_DELAY_MS);
+	msg2638->ready = jiffies + msecs_to_jiffies(msg2638->chip_data->boot_ms);
 }
 
 static int msg2638_start(struct msg2638_ts_data *msg2638)
@@ -215,7 +310,7 @@
 		return -EINVAL;
 	}
 
-	error = input_mt_init_slots(input_dev, MAX_SUPPORTED_FINGER_NUM,
+	error = input_mt_init_slots(input_dev, msg2638->chip_data->max_fingers,
 				    INPUT_MT_DIRECT | INPUT_MT_DROP_UNUSED);
 	if (error) {
 		dev_err(dev, "Failed to initialize MT slots: %d\n", error);
@@ -249,6 +344,12 @@
 	msg2638->client = client;
 	i2c_set_clientdata(client, msg2638);
 
+	msg2638->chip_data = of_device_get_match_data(dev);
+	if (!msg2638->chip_data) {
+		dev_err(dev, "Invalid or missing chip data\n");
+		return -EINVAL;
+	}
+
 	msg2638->supplies[0].supply = "vdd";
 	msg2638->supplies[1].supply = "vddio";
 	error = devm_regulator_bulk_get(dev, ARRAY_SIZE(msg2638->supplies),
@@ -272,7 +373,7 @@
 	}
 
 	error = devm_request_threaded_irq(dev, client->irq,
-					  NULL, msg2638_ts_irq_handler,
+					  NULL, msg2638->chip_data->irq_handler,
 					  IRQF_ONESHOT | IRQF_NO_AUTOEN,
 					  client->name, msg2638);
 	if (error) {
@@ -316,8 +417,20 @@
 
 static SIMPLE_DEV_PM_OPS(msg2638_pm_ops, msg2638_suspend, msg2638_resume);
 
+static const struct msg_chip_data msg2138_data = {
+	.irq_handler = msg2138_ts_irq_handler,
+	.max_fingers = MSG2138_MAX_FINGERS,
+	.boot_ms = 1300,	/* measured 1175 ms on a msg2133 */
+};
+
+static const struct msg_chip_data msg2638_data = {
+	.irq_handler = msg2638_ts_irq_handler,
+	.max_fingers = MAX_SUPPORTED_FINGER_NUM,
+};
+
 static const struct of_device_id msg2638_of_match[] = {
-	{ .compatible = "mstar,msg2638" },
+	{ .compatible = "mstar,msg2138", .data = &msg2138_data },
+	{ .compatible = "mstar,msg2638", .data = &msg2638_data },
 	{ }
 };
 MODULE_DEVICE_TABLE(of, msg2638_of_match);
